# R session and project files
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Renviron
.Rproj.user/

# Local dependency library and package checks
Rlib/
renv/library/
renv/staging/
*.Rcheck/
*-Ex.R

# Notebook intermediates
*_cache/
cache/
*.utf8.md
*.knit.md
notebooks/.cache/
notebooks/rendered/
notebooks/*_files/

# Public downloads and processed matrices
data/public/raw/*
!data/public/raw/.gitkeep
data/public/processed/*
!data/public/processed/.gitkeep
data/public/*/source/
data/public/*/processed/
data/public/*/audit/
data/public/*/manifests/
data/public/*/*.log

# Reconstructed repeated-simulation bundles; SIM01 is the committed canonical input
data/simulated/canonical/SIM0[2-9]/
data/simulated/canonical/SIM10/

# Restricted inputs
data/private/

# Large generated analysis outputs; compact final results are committed
results/*
!results/README.md
!results/final/
!results/final/**

# Scheduler and temporary files
scheduler/
slurm-*.out
*.tmp
*.zip

# Local tool configuration and operating-system files
.DS_Store
